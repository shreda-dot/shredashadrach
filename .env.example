# Required for production. Use your canonical HTTPS domain on Vercel.
SITE_URL=http://localhost:3000

# International format, digits only. Use your real number in .env.local.
NEXT_PUBLIC_WHATSAPP_NUMBER=YOUR_WHATSAPP_NUMBER

# Server-side Formspree endpoint used by the contact route.
CONTACT_DELIVERY_URL=https://formspree.io/.

# Set to 1 only for local builds while visible [TODO: ...] copy remains.
# Never set this in production.
TODO_CHECK_BYPASS=
